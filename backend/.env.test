# Test-only credentials, committed on purpose: the taskflow_test role owns the
# taskflow_test database and nothing else (it can't even CONNECT to the dev
# database). CI's throwaway Postgres container uses the same ones.
# 127.0.0.1, not localhost: the datastores' host ports are bound to IPv4
# loopback only, and on Windows localhost tries ::1 first and stalls ~2 s
# per new connection before falling back.
DATABASE_URL=postgresql://taskflow_test:taskflow_test_only@127.0.0.1:5433/taskflow_test
REDIS_URL=redis://127.0.0.1:6379/1
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
JWT_SECRET=test_secret_do_not_use_in_prod_padded_to_32_bytes_minimum
