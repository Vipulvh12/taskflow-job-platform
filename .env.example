POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_dev_password
POSTGRES_DB=taskflow
# These are the Docker-network hostnames, used once the API/worker run as
# containers (Phase 13). Until then the backend runs on the host, so your local
# .env must point at the published ports instead:
#   DATABASE_URL=postgresql://taskflow:taskflow_dev_password@localhost:5433/taskflow
#   REDIS_URL=redis://localhost:6379/0
#   RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Note the 5433: a native PostgreSQL service may already own host port 5432.
DATABASE_URL=postgresql://taskflow:taskflow_dev_password@postgres:5432/taskflow
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
JWT_SECRET=change_me_in_real_env
